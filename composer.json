{
    "name": "blesta/ai-client",
    "description": "PHP client library for interacting with Blesta AI API",
    "type": "library",
    "keywords": ["blesta", "ai", "chat", "embeddings", "api", "client"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11"
    },
    "autoload": {
        "psr-4": {
            "BlestaAi\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlestaAi\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
